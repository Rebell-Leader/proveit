# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory: https://tokenfactory.nebius.com (API keys page)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs on Token Factory. Run `uv run proveit smoke` to list the exact Nemotron IDs on your account.
# Also available (2026-10-26): nvidia/nemotron-3-super-120b-a12b, nvidia/Nemotron-3.5-Super-VL, nvidia/Nemotron-3_5-Lightning
PROVEIT_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PROVEIT_MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily (used from day 2 for CVE / advisory cross-checks)
TAVILY_API_KEY=
