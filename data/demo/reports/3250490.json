  return 0;", "notes": []}, {"n": 141, "text": "  }", "notes": []}, {"n": 142, "text": "", "notes": []}, {"n": 143, "text": "  if(config->tracetype == TRACE_PLAIN) {", "notes": []}, {"n": 144, "text": "    static bool newl = FALSE;", "notes": []}, {"n": 145, "text": "    static bool traced_data = FALSE;", "notes": []}, {"n": 146, "text": "", "notes": []}, {"n": 147, "text": "    switch(type) {", "notes": []}, {"n": 148, "text": "    case CURLINFO_HEADER_OUT:", "notes": []}, {"n": 149, "text": "      if(size > 0) {", "notes": []}, {"n": 150, "text": "        size_t st = 0;", "notes": []}, {"n": 151, "text": "        size_t i;", "notes": []}, {"n": 152, "text": "        for(i = 0; i < size - 1; i++) {", "notes": []}, {"n": 153, "text": "          if(data[i] == '\\n') { /* LF */", "notes": []}, {"n": 154, "text": "            if(!newl) {", "notes": []}, {"n": 155, "text": "              log_line_start(output, timebuf, idsbuf, type);", "notes": []}, {"n": 156, "text": "            }", "notes": []}, {"n": 157, "text": "            (void)fwrite(data + st, i - st + 1, 1, output);", "notes": []}, {"n": 158, "text": "            st = i + 1;", "notes": []}, {"n": 159, "text": "            newl = FALSE;", "notes": []}, {"n": 160, "text": "          }", "notes": []}, {"n": 161, "text": "        }", "notes": []}, {"n": 162, "text": "        if(!newl)", "notes": []}, {"n": 163, "text": "          log_line_start(output, timebuf, idsbuf, type);", "notes": []}, {"n": 164, "text": "        (void)fwrite(data + st, i - st + 1, 1, output);", "notes": []}, {"n": 165, "text": "      }", "notes": []}, {"n": 166, "text": "      newl = (size && (data[size - 1] != '\\n'));", "notes": []}, {"n": 167, "text": "      traced_data = FALSE;", "notes": []}, {"n": 168, "text": "      break;", "notes": []}, {"n": 169, "text": "    case CURLINFO_TEXT:", "notes": []}, {"n": 170, "text": "    case CURLINFO_HEADER_IN:", "notes": []}, {"n": 171, "text": "      if(!newl)", "notes": []}, {"n": 172, "text": "        log_line_start(output, timebuf, idsbuf, type);", "notes": []}, {"n": 173, "text": "      (void)fwrite(data, size, 1, output);", "notes": []}, {"n": 174, "text": "      newl = (size && (data[size - 1] != '\\n'));", "notes": []}, {"n": 175, "text": "      traced_data = FALSE;", "notes": []}, {"n": 176, "text": "      break;", "notes": []}, {"n": 177, "text": "    case CURLINFO_DATA_OUT:", "notes": []}, {"n": 178, "text": "    case CURLINFO_DATA_IN:", "notes": []}, {"n": 179, "text": "    case CURLINFO_SSL_DATA_IN:", "notes": []}, {"n": 180, "text": "    case CURLINFO_SSL_DATA_OUT:", "notes": []}, {"n": 181, "text": "      if(!traced_data) {", "notes": []}, {"n": 182, "text": "        /* if the data is output to a tty and we are sending this debug trace", "notes": []}, {"n": 183, "text": "           to stderr or stdout, we do not display the alert about the data not", "notes": []}, {"n": 184, "text": "           being shown as the data _is_ shown then just not via this", "notes": []}, {"n": 185, "text": "           function */", "notes": []}, {"n": 186, "text": "        if(!config->isatty ||", "notes": []}, {"n": 187, "text": "           ((output != tool_stderr) && (output != stdout))) {", "notes": []}, {"n": 188, "text": "          if(!newl)", "notes": []}, {"n": 189, "text": "            log_line_start(output, timebuf, idsbuf, type);", "notes": []}, {"n": 190, "text": "          fprintf(output, \"[%zu bytes data]\\n\", size);", "notes": []}, {"n": 191, "text": "          newl = FALSE;", "notes": []}, {"n": 192, "text": "          traced_data = TRUE;", "notes": []}, {"n": 193, "text": "        }", "notes": []}, {"n": 194, "text": "      }", "notes": []}, {"n": 195, "text": "      break;", "notes": []}, {"n": 196, "text": "    default: /* nada */", "notes": []}, {"n": 197, "text": "      newl = FALSE;", "notes": []}, {"n": 198, "text": "      traced_data = FALSE;", "notes": []}, {"n": 199, "text": "      break;", "notes": []}, {"n": 200, "text": "    }", "notes": []}, {"n": 201, "text": "", "notes": []}, {"n": 202, "text": "    return 0;", "notes": []}, {"n": 203, "text": "  }", "notes": []}, {"n": 204, "text": "", "notes": []}, {"n": 205, "text": "  switch(type) {", "notes": []}, {"n": 206, "text": "  case CURLINFO_TEXT:", "notes": []}, {"n": 207, "text": "    fprintf(output, \"%s%s== Info: %.*s\", timebuf, idsbuf, (int)size, data);", "notes": []}, {"n": 208, "text": "    FALLTHROUGH();", "notes": []}, {"n": 209, "text": "  default: /* in case a new one is introduced to shock us */", "notes": []}, {"n": 210, "text": "    return 0;", "notes": []}, {"n": 211, "text": "", "notes": []}, {"n": 212, "text": "  case CURLINFO_HEADER_OUT:", "notes": []}, {"n": 213, "text": "    text = \"=> Send header\";", "notes": []}, {"n": 214, "text": "    break;", "notes": []}, {"n": 215, "text": "  case CURLINFO_DATA_OUT:", "notes": []}, {"n": 216, "text": "    text = \"=> Send data\";", "notes": []}, {"n": 217, "text": "    break;", "notes": []}, {"n": 218, "text": "  case CURLINFO_HEADER_IN:", "notes": []}, {"n": 219, "text": "    text = \"<= Recv header\";", "notes": []}, {"n": 220, "text": "    break;", "notes": []}, {"n": 221, "text": "  case CURLINFO_DATA_IN:", "notes": []}, {"n": 222, "text": "    text = \"<= Recv data\";", "notes": []}, {"n": 223, "text": "    break;", "notes": []}, {"n": 224, "text": "  case CURLINFO_SSL_DATA_IN:", "notes": []}, {"n": 225, "text": "    text = \"<= Recv SSL data\";", "notes": []}, {"n": 226, "text": "    break;", "notes": []}, {"n": 227, "text": "  case CURLINFO_SSL_DATA_OUT:", "notes": []}, {"n": 228, "text": "    text = \"=> Send SSL data\";", "notes": []}, {"n": 229, "text": "    break;", "notes": []}, {"n": 230, "text": "  }", "notes": []}, {"n": 231, "text": "", "notes": []}, {"n": 232, "text": "  dump(timebuf, idsbuf, text, output, (unsigned char *) data, size,", "notes": []}, {"n": 233, "text": "       config->tracetype, type);", "notes": []}, {"n": 234, "text": "  return 0;", "notes": []}, {